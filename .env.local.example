# Supabase (プロジェクト Settings > API から取得)
# service_role キー（公開しないこと）
SB_KEY=

# 互換用: SB_KEY が未設定のときに参照される
SUPABASE_SERVICE_ROLE_KEY=

# AI 連携: 合鍵（トークン）を発行・取り消しできる人だけが知っているキー。長いランダムな文字列にする。
# 未設定の間は、合鍵の発行・取り消しが 503 で止まる（誤って無防備にならない）。
MYFLOW_ADMIN_KEY=

# （旧方式・非推奨）共有キー。使うと プライベートのみ・削除不可 に制限される。使わないなら設定しない。
GPT_API_KEY=

# ローカル確認・テスト用: 接続先を本番ではなくモックDBに向ける（scripts/dev-mock.mjs が自動で設定する）
# SUPABASE_REST_URL=http://127.0.0.1:54321/rest/v1

# 注意: 本番の Supabase の URL は lib/db.ts に直接記述されています。
# プロジェクトを移行する場合はそちらも更新してください。
